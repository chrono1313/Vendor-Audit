# /etc/vendor-audit/web.env
#
# Runtime configuration for the Vendor Audit web service. Read by systemd
# via EnvironmentFile= in vendor-audit.service. These values override the
# defaults in vendor_audit/web/app.py.
#
# Permissions: this file should be 0640, owned root:vendor-audit. Only
# root edits it; the service user reads it.
#
#   sudo install -d -m 0755 /etc/vendor-audit
#   sudo install -m 0640 -o root -g vendor-audit \
#       deploy/web.env.example /etc/vendor-audit/web.env
#
# Restart the service after any change:
#   sudo systemctl restart vendor-audit

# ─────────────────────────────────────────────────────────────────────────
# Process pool configuration
# ─────────────────────────────────────────────────────────────────────────

# Number of process-pool workers. Each worker holds the full audit
# library in memory (~150MB resident) and processes one audit at a
# time. Audits are I/O-bound (mostly waiting on DNS/HTTPS), so
# concurrency is dominated by socket waits rather than CPU. 8 workers
# gives comfortable headroom for ~50-100 simultaneous visitors while
# staying well within typical memory budgets (~1.2GB total).
VENDOR_AUDIT_WORKERS=8

# Wall-clock cap per audit at the web layer. The audit itself has its
# own internal deadlines (check_redirect 6s, parallel pool ~15s,
# post-pool ~7s — see audit.AUDIT_WALL_DEADLINE_S). This is the outer
# safety net for runaway audits. Worst-case audit time is ~28s plus
# render, so 35s gives comfortable headroom.
VENDOR_AUDIT_TIMEOUT_S=35

# ─────────────────────────────────────────────────────────────────────────
# Rate limits (slowapi-compatible strings)
# ─────────────────────────────────────────────────────────────────────────

# /audit (POST) — the expensive endpoint. The Cloudflare WAF rule already
# rate-limits at the edge; this is a second layer keyed on the real
# client IP (CF-Connecting-IP). 3 audits per 10 seconds per client is
# the handoff's recommended figure.
VENDOR_AUDIT_LIMIT_AUDIT=3/10seconds

# / (form page) and other lightweight reads. 60/min is generous; this
# only stops pure flooding. The .txt endpoint has its own in-memory
# cache and is not rate-limited at this layer (see TXT_CACHE_TTL_S below).
VENDOR_AUDIT_LIMIT_FORM=60/minute

# ─────────────────────────────────────────────────────────────────────────
# security.txt (RFC 9116)
# ─────────────────────────────────────────────────────────────────────────

# Where security researchers should report vulnerabilities. URL or mailto:.
# The default uses GitHub's private security advisory flow which routes
# to project owner without exposing an email address.
VENDOR_AUDIT_SECURITY_CONTACT=https://github.com/chrono1313/Vendor-Audit/security/advisories/new

# Expiry date in ISO 8601 UTC format. RFC 9116 requires this. If unset
# the app defaults to "1 year from server start" — meaning a service
# restart rolls the date forward, but if you go a long time between
# restarts the file may legitimately expire. Setting an explicit value
# here and rotating it during scheduled maintenance is recommended.
# VENDOR_AUDIT_SECURITY_EXPIRES=2027-05-01T00:00:00Z

# Language code(s) for security correspondence. Comma-separated per RFC 9116.
VENDOR_AUDIT_SECURITY_LANG=en

# ─────────────────────────────────────────────────────────────────────────
# Proxy header trust
# ─────────────────────────────────────────────────────────────────────────

# Trust X-Forwarded-For / CF-Connecting-IP from the proxy. MUST be 1 in
# production (cloudflared sends connections from 127.0.0.1 with the real
# client IP in headers; without this the rate limiter would key every
# request to "127.0.0.1" and rate-limit globally instead of per-client).
#
# Set to 0 ONLY when running locally without a proxy in front, e.g. for
# local development against the bare service.
VENDOR_AUDIT_TRUST_PROXY=1

# ─────────────────────────────────────────────────────────────────────────
# Public-facing URL
# ─────────────────────────────────────────────────────────────────────────

# The publicly accessible URL of this service. Embedded in:
# The publicly accessible URL of this service. Used in security.txt's
# Canonical: line (RFC 9116). Self-hosters should set this to their own
# URL. The .txt report header always shows https://vendoraudit.org as
# the canonical project home regardless of this setting.
VENDOR_AUDIT_SERVICE_URL=https://vendoraudit.org

# ─────────────────────────────────────────────────────────────────────────
# Unified result cache (HTML + TXT)
# ─────────────────────────────────────────────────────────────────────────
#
# A single cache holds the rendered HTML page and the rendered .txt
# report for each audited domain. They share a TTL so a download
# triggered from a cached HTML view returns the txt that corresponds
# *exactly* to that HTML (same audit run, same timestamp, same
# findings).
#
# 24 hours: most vendor security postures don't change daily; cache hits
# across a full day of viral-link traffic save substantial worker-pool
# work. The age of the cached result is displayed prominently to the
# user ("Scanned N hours ago") so a stale view is honest rather than
# deceptive — and the re-audit form posts with ?fresh=1 to bypass this
# cache for anyone explicitly asking for a fresh audit.
VENDOR_AUDIT_HTML_CACHE_TTL_S=86400

# Hard cap on cache entries. ~80KB per entry (HTML + TXT) × 1000 entries
# = ~80MB max. Sized for sustained viral traffic across the 24-hour TTL
# window.
VENDOR_AUDIT_HTML_CACHE_MAX=1000

# Note: VENDOR_AUDIT_TXT_CACHE_TTL_S and VENDOR_AUDIT_TXT_CACHE_MAX are
# deprecated — the txt cache was merged into the unified result cache
# above. Setting them is harmless but produces a startup warning.
