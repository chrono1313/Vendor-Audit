def _href(**params):
    return "/?" + urlencode({k: v for k, v in params.items() if v})


def _result_url(site, domain, deep=False):
    """The public result page for a domain: served from the site's cache
    when it has a result, otherwise audited again."""
    return f"{site}/audit/result?" + urlencode({"domain": domain, **({"deep": "1"} if deep else {})})


def render(query, rows_for, tz_name="UTC", viewer="", site="https://vendoraudit.org"):
    """The page for a query dict (from parse_qs); rows_for(since) reads the log."""
    q = {k: (v[0] if v else "") for k, v in query.items()}
    ip = q.get("ip", "").strip()[:64]
    domain = q.get("domain", "").strip().lower().rstrip(".")[:253]
    try:                                          # the one search box takes either
        ip, domain = str(ipaddress.ip_address(domain)), ""
    except ValueError:
        pass
    view = "top" if q.get("view") == "top" else "list"
    show_all = q.get("all") == "1"
    since = q.get("since") if q.get("since") in SINCE else ("30d" if (ip or domain or view == "top") else "24h")
    esc = html.escape

    error = None
    try:
        rows = rows_for(SINCE[since], show_all)
    except Exception as exc:
        rows, error = [], str(exc)
    if ip:
        rows = [r for r in rows if r["ip"] == ip]
    if domain:
        rows = [r for r in rows if r["domain"].lower() == domain]

    keep = dict(ip=ip, domain=domain, all="1" if show_all else "")
    chips = []
    for key, label in (("24h", "24 hours"), ("7d", "7 days"), ("30d", "30 days")):
        cls = ' class="on"' if (since == key and view == "list") else ""
        chips.append(f'<a{cls} href="{esc(_href(since=key, **keep))}">{label}</a>')
    cls = ' class="on"' if view == "top" else ""
    chips.append(f'<a{cls} href="{esc(_href(view="top", since=since, **keep))}">Top</a>')
    if ip or domain:
        chips.append(f'<a href="{esc(_href(since=since))}">Clear filter</a>')

    parts = [f"<h1>Audit log</h1><div class=mute>{len(rows)} request{'s' if len(rows) != 1 else ''}, "
             f"last {esc({'24h': '24 hours', '7d': '7 days', '30d': '30 days'}[since])}"
             + (f" · visitor {esc(ip)}" if ip else "") + (f" · {esc(domain)}" if domain else "")
             + f" · times {esc(tz_name)}</div>",
             "<nav>" + "".join(chips) + "</nav>",
             '<form method=get action="/"><input name=domain placeholder="Domain or visitor IP" '
             f'value="{esc(domain or ip)}" autocapitalize=off autocorrect=off spellcheck=false>'
             f'<input type=hidden name=since value="{esc(since)}"><button>Filter</button></form>']
    if error:
        parts.append(f"<p>Could not read the log: {esc(error)}</p>")
    elif view == "top":
        parts.append("<div class=top>")
        for title, counts, key in (("Visitors", Counter(r["ip"] for r in rows), "ip"),
                                   ("Domains", Counter(r["domain"] for r in rows), "domain")):
            parts.append(f"<h2>{title} ({len(counts)})</h2>")
            for name, n in counts.most_common(25):
                link = esc(_href(since=since, **{key: name}))
                view = (f' · <a href="{esc(_result_url(site, name))}" target=_blank rel="noopener noreferrer">View</a>'
                        if key == "domain" else "")
                parts.append(f'<div><span><a href="{link}">{esc(name)}</a>{view}</span><span>{n}</span></div>')
        parts.append("</div>")
    else:
        shown = list(reversed(rows))[:MAX_ROWS]
        for r in shown:
            when = f"{r['time']:%b %d %H:%M:%S}"
            deep = "deep" in r["what"]
            view = esc(_result_url(site, r["domain"], deep))
            parts.append(
                f'<div class=row><div class=d><a href="{esc(_href(domain=r["domain"], since=since))}">'
                f'{esc(r["domain"])}</a><a class=v href="{view}" target=_blank rel="noopener noreferrer">'
                f'View{" deep" if deep else ""} \u203a</a></div><div class=m>{esc(when)} · {esc(r["what"])} · '
                f'<a href="{esc(_href(ip=r["ip"], since=since))}">{esc(r["ip"])}</a></div></div>')
        if len(rows) > MAX_ROWS:
            parts.append(f"<p class=mute>Showing the newest {MAX_ROWS}. Narrow it with a filter.</p>")
        if not rows:
            parts.append("<p class=mute>Nothing in this period.</p>")
    other = _href(since=since, ip=ip, domain=domain, view="top" if view == "top" else "",
                  all="" if show_all else "1")
    parts.append(f'<p class=mute><a href="{esc(other)}">'
                 + ("Fold re-audit follow-ups" if show_all else "Show re-audit follow-ups") + "</a>"
                 + (f" · signed in as {esc(viewer)}" if viewer else "")
                 + ' · <a href="/cdn-cgi/access/logout">Sign out</a></p>')
    return ("<!doctype html><html lang=en><head><meta charset=utf-8>"
            '<meta name=viewport content="width=device-width,initial-scale=1">'
            '<meta name=robots content="noindex,nofollow">'
            f"<title>Audit log</title><style>{_CSS}</style></head><body>"
            + "".join(parts) + "</body></html>")


# ── HTTP ────────────────────────────────────────────────────────────────────

_HEADERS = {
    "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; "
                               "base-uri 'none'; frame-ancestors 'none'",
    "Cache-Control": "no-store",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "X-Robots-Tag": "noindex, nofollow",
}


class Handler(BaseHTTPRequestHandler):
    server_version = "vendor-audit-logview"
    sys_version = ""

    def _send(self, status, body, ctype="text/plain; charset=utf-8"):
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        for k, v in _HEADERS.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        url = urlsplit(self.path)
        if url.path == "/healthz":
            return self._send(200, "ok\n")
        claims = self.server.verifier.verify(self.headers.get("Cf-Access-Jwt-Assertion", ""))
        if claims is None:
            return self._send(403, "Forbidden: sign in through Cloudflare Access.\n")
        if url.path != "/":
            return self._send(404, "Not found\n")
        cfg = self.server.config
        try:
            query = parse_qs(url.query, max_num_fields=10)
        except ValueError:
            query = {}
        page = render(query,
                      lambda since, all_: read_rows(since, cfg["tz"], cfg["namespace"], all_),
                      cfg["tz_name"], claims.get("email", ""), cfg["site"])
        self._send(200, page, "text/html; charset=utf-8")

    def log_message(self, fmt, *args):            # one short line per request, no query string
        print(f"{self.command} {urlsplit(self.path).path} {args[1] if len(args) > 1 else ''}",
              file=sys.stderr)


def config_from_env(env=os.environ):
    team = env.get("ACCESS_TEAM_DOMAIN", "").strip().lower()
    aud = env.get("ACCESS_AUD", "").strip().lower()
    if not _TEAM_RE.fullmatch(team):
        raise SystemExit("vendor-audit-logview: ACCESS_TEAM_DOMAIN must look like yourteam.cloudflareaccess.com")
    if not _AUD_RE.fullmatch(aud):
        raise SystemExit("vendor-audit-logview: ACCESS_AUD must be the application's 64-hex-digit AUD tag")
    tz_name = env.get("LOGVIEW_TZ", "UTC").strip() or "UTC"
    site = env.get("LOGVIEW_SITE", "https://vendoraudit.org").strip().rstrip("/")
    if not re.fullmatch(r"https://[a-z0-9.-]+", site):
        raise SystemExit("vendor-audit-logview: LOGVIEW_SITE must be https://<hostname>")
    from zoneinfo import ZoneInfo
    return {"team": team, "aud": aud, "tz_name": tz_name, "tz": ZoneInfo(tz_name), "site": site,
            "port": int(env.get("LOGVIEW_PORT", "8001")), "namespace": LOG.NAMESPACE}


def main():
    cfg = config_from_env()
    server = ThreadingHTTPServer(("127.0.0.1", cfg["port"]), Handler)
    server.verifier = AccessVerifier(cfg["team"], cfg["aud"])
    server.config = cfg
    print(f"vendor-audit-logview on 127.0.0.1:{cfg['port']} for {cfg['team']}", file=sys.stderr)
    server.serve_forever()


if __name__ == "__main__":
    main()
