#!/usr/bin/env python3
"""vendor-audit-logview — the 30-day audit log as a web page, for a phone.

The same table `vendor-audit-log` prints, served on 127.0.0.1:8001 and
published through the Cloudflare tunnel at its own hostname, behind
Cloudflare Access: Cloudflare signs the viewer in (a one-time code by
email) before a request reaches this machine. This service then checks
the token Access attaches to every signed-in request (the
Cf-Access-Jwt-Assertion header: an RS256 JWT signed by the team's keys,
for this application's audience), so a request that didn't come through
Access is refused even if the tunnel or DNS were ever misconfigured.

    GET /            the log: last 24 hours, newest first
        ?since=7d    24h | 7d | 30d
        ?ip=…        one visitor (all 30 days unless since= is given)
        ?domain=…    one audited domain (likewise)
        ?view=top    busiest visitors and domains
        ?all=1       include re-audits' follow-up cache hits
    GET /healthz     "ok" (no sign-in; says nothing about the log)

Configuration (deploy/vendor-audit-logview.service, EnvironmentFile
/etc/vendor-audit/logview.env):
    ACCESS_TEAM_DOMAIN  e.g. yourteam.cloudflareaccess.com
    ACCESS_AUD          the Access application's AUD tag (64 hex digits)
    LOGVIEW_TZ          time zone for the page (default UTC)
    LOGVIEW_PORT        default 8001
    LOGVIEW_SITE        the public site, for each row's "View" link to
                        that domain's result page (default
                        https://vendoraudit.org): a cached result if
                        there is one, otherwise the site audits it again

Read-only: it runs journalctl on the vendor-audit namespace and nothing
else. Standard library only; reuses the parsing in vendor-audit-log,
which sits next to it in deploy/.
"""

import base64
import hashlib
import hmac
import html
import ipaddress
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.request
from collections import Counter
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from urllib.parse import parse_qs, urlencode, urlsplit


def _load_log_tool():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "vendor-audit-log")
    loader = SourceFileLoader("vendor_audit_log", path)
    mod = module_from_spec(spec_from_loader("vendor_audit_log", loader))
    loader.exec_module(mod)
    return mod


LOG = _load_log_tool()

SINCE = {"24h": "24 hours ago", "7d": "7 days ago", "30d": "30 days ago"}
MAX_ROWS = 1000
_TEAM_RE = re.compile(r"[a-z0-9][a-z0-9-]*\.cloudflareaccess\.com")
_AUD_RE = re.compile(r"[0-9a-f]{64}")


# ── Cloudflare Access token check ───────────────────────────────────────────
# RS256 = RSASSA-PKCS1-v1_5 with SHA-256 (RFC 7518 §3.3, RFC 8017 §8.2.2).
# Verification recomputes the whole expected encoded message and compares
# it byte for byte, rather than parsing the decrypted block, so there is no
# parsing for a forged signature to slip through.

_SHA256_DIGEST_INFO = bytes.fromhex("3031300d060960864801650304020105000420")


def _b64url(s):
    if isinstance(s, str):
        s = s.encode("ascii")
    return base64.urlsafe_b64decode(s + b"=" * (-len(s) % 4))


def rs256_verify(n, e, signing_input, signature):
    k = (n.bit_length() + 7) // 8
    if k < 256 or len(signature) != k:            # 2048-bit keys or larger
        return False
    s = int.from_bytes(signature, "big")
    if s >= n:
        return False
    em = pow(s, e, n).to_bytes(k, "big")
    t = _SHA256_DIGEST_INFO + hashlib.sha256(signing_input).digest()
    expected = b"\x00\x01" + b"\xff" * (k - len(t) - 3) + b"\x00" + t
    return hmac.compare_digest(em, expected)


def _fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "vendor-audit-logview"})
    with urllib.request.urlopen(req, timeout=5) as resp:
        return json.loads(resp.read(256 * 1024))


class AccessVerifier:
    """Checks Cf-Access-Jwt-Assertion tokens against the team's public
    keys (fetched from <team>/cdn-cgi/access/certs, cached for an hour,
    refetched early when a token names a key not seen yet, at most once a
    minute) and this application's AUD tag."""

    LEEWAY = 60                                   # seconds of clock skew allowed

    def __init__(self, team_domain, aud, fetch=_fetch_json, clock=time.time):
        self.issuer = f"https://{team_domain}"
        self.certs_url = f"{self.issuer}/cdn-cgi/access/certs"
        self.aud = aud
        self._fetch, self._clock = fetch, clock
        self._keys, self._fetched, self._tried = {}, 0.0, 0.0
        self._lock = threading.Lock()

    def _refresh(self, unknown_kid=False):
        with self._lock:
            now = self._clock()
            if unknown_kid:
                if now - self._tried < 60:
                    return
            elif self._keys and now - self._fetched < 3600:
                return
            self._tried = now
            try:
                data = self._fetch(self.certs_url)
                keys = {}
                for k in data.get("keys") or []:
                    if k.get("kty") == "RSA" and k.get("kid") and k.get("n") and k.get("e"):
                        keys[k["kid"]] = (int.from_bytes(_b64url(k["n"]), "big"),
                                          int.from_bytes(_b64url(k["e"]), "big"))
            except Exception as exc:              # keep the keys we have
                print(f"vendor-audit-logview: could not fetch Access keys: {exc}", file=sys.stderr)
                return
            if keys:
                self._keys, self._fetched = keys, now

    def verify(self, token):
        """The token's claims if it is valid for this application, else None."""
        try:
            if not token or len(token) > 8192:
                return None
            head_b64, body_b64, sig_b64 = token.split(".")
            header = json.loads(_b64url(head_b64))
            if header.get("alg") != "RS256":
                return None
            self._refresh()
            key = self._keys.get(header.get("kid"))
            if key is None:
                self._refresh(unknown_kid=True)
                key = self._keys.get(header.get("kid"))
            if key is None:
                return None
            if not rs256_verify(key[0], key[1], f"{head_b64}.{body_b64}".encode("ascii"), _b64url(sig_b64)):
                return None
            claims = json.loads(_b64url(body_b64))
            aud = claims.get("aud")
            if self.aud not in (aud if isinstance(aud, list) else [aud]):
                return None
            if claims.get("iss") != self.issuer:
                return None
            now = self._clock()
            exp = claims.get("exp")
            if not isinstance(exp, (int, float)) or now > exp + self.LEEWAY:
                return None
            nbf = claims.get("nbf")
            if isinstance(nbf, (int, float)) and now + self.LEEWAY < nbf:
                return None
            return claims
        except Exception:                         # malformed token of any kind
            return None


# ── The log ─────────────────────────────────────────────────────────────────

def read_rows(since, tz=None, namespace=None, include_follow_ups=False):
    """Audit-log rows since `since` (a journalctl time), oldest first."""
    cmd = ["journalctl", f"--namespace={namespace or LOG.NAMESPACE}", "-u", LOG.UNIT,
           "-o", "json", "--no-pager", "--since", since]
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    folder = LOG.Folder()
    rows = []
    for line in proc.stdout.splitlines():
        row = LOG.parse_entry(line, tz)
        if row is None or (not include_follow_ups and not folder.keep(row)):
            continue
        rows.append(row)
    if proc.returncode != 0 and not rows:
        raise RuntimeError((proc.stderr or "journalctl failed").strip()[:300])
    return rows


